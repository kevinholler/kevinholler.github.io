---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/site.css';
import SiteHead from '../components/SiteHead.astro';
import SiteFoot from '../components/SiteFoot.astro';

interface Props {
  title: string;
  description: string;
  /** Which nav item to mark as the current page. */
  here?: 'index' | 'writing' | 'projects' | 'talks' | 'about';
  /** 'spread' widens the page and turns on the two-column grid. Reading
   *  pages stay 'single' — an essay has nothing to put beside itself. */
  layout?: 'single' | 'spread';
}

const { title, description, here, layout = 'single' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en" data-layout={layout === 'spread' ? 'spread' : undefined}>
  <head>
    <script is:inline>
      // Before first paint, so a returning dark-theme reader never sees a
      // flash of light. No stored choice means light, whatever the OS says.
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
        }
      } catch (e) {}
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <!-- Light, so the initial canvas matches the default before CSS lands.
         The `color-scheme` property on [data-theme='dark'] overrides it. -->
    <meta name="color-scheme" content="light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />

    <!-- Work in progress. Nothing under /new/ should be indexed
         or crawled until it replaces the site at the root. -->
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHead here={here} />
    <main id="main">
      <div class="col">
        <slot />
      </div>
    </main>
    <SiteFoot />
  </body>
</html>
