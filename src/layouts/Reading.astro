---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/site.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SiteHead from '../components/SiteHead.astro';
import SiteFoot from '../components/SiteFoot.astro';
import LifeField from '../components/LifeField.astro';
import type { NavId } from '../data/nav';

interface Props {
  title: string;
  description: string;
  /** Which nav item to mark as the current page. */
  here?: NavId;
  /** 'spread' widens the page and turns on the two-column grid. Reading
   *  pages stay 'single' — an essay has nothing to put beside itself. */
  layout?: 'single' | 'spread';
  /** The Game of Life field behind the page. Front page only by default —
   *  an essay deserves a still page to be read on. */
  backdrop?: boolean;
  /** Let search engines index the page. Everything under /new/ is hidden
   *  until the rebuild moves to the root; a page that is public now (the
   *  book) opts in. */
  indexed?: boolean;
  /** The picture shown when the page is shared (og:image). */
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  title,
  description,
  here,
  layout = 'single',
  backdrop = false,
  indexed = false,
  image,
  imageAlt,
} = Astro.props;

const ogImage = image
  ? new URL((await getImage({ src: image, width: 800, format: 'jpg' })).src, Astro.site).toString()
  : undefined;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en" data-layout={layout === 'spread' ? 'spread' : undefined}>
  <head>
    <script is:inline>
      // Before first paint, so a returning light-theme reader never sees a
      // flash of dark. No stored choice means dark, whatever the OS says.
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
        }
      } catch (e) {}
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <!-- Dark, so the initial canvas matches the default before CSS lands.
         The `color-scheme` property on [data-theme='light'] overrides it. -->
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <!-- Work in progress. Nothing under /new/ should be indexed or crawled
         until it replaces the site at the root; public pages opt out. -->
    {!indexed && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {backdrop && <LifeField />}
    <SiteHead here={here} />
    <main id="main">
      <div class="col">
        <slot />
      </div>
    </main>
    <SiteFoot />
  </body>
</html>
