---
import { Image } from 'astro:assets';
import Reading from '../../layouts/Reading.astro';
import BookSignup from '../../components/BookSignup.astro';
import {
  book,
  bars,
  freeChapters,
  moments,
  parts,
  pitch,
  praise,
  promises,
} from '../../data/book';
import cover from '../../assets/book/cover.png';
import portrait from '../../assets/portrait/kevin-holler.jpg';

/*
  The book page. Its URL is the book's title, set once in src/data/book.ts
  (`slug`), so a new title is a one-line change. /book/ redirects here.

  One job: turn a visit into a subscriber. The shape follows a strong book
  landing page, adapted for a book that isn't out:

    1. Hero band — cover, title, pitch, and the offer with the form.
    2. The shape — sixteen chapters in three parts, drawn as the cover's
       bars.
    3. What you'll read — moments from the book, in order.
    4. How it's written — why, and four promises from the style guide.
    5. Early readers — appears once `praise` has a quote.
    6. About the author.
    7. Closing band — the offer again.

  Every word on it obeys the rules at the top of src/data/book.ts — above
  all: no private details, and nothing that gives away the ending.
*/

export function getStaticPaths() {
  return [{ params: { book: book.slug } }];
}

const description = `${book.title} — ${book.subtitle.toLowerCase()}. A memoir by Kevin Holler. Read ${book.freebie} free.`;
const coverAlt = `Cover of ${book.title}, ${book.subtitle}, by Kevin Holler: the title in heavy black capitals over a row of rainbow-coloured bars that fall away to the right.`;
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

// Which part each bar belongs to, for the part labels under the chart.
let start = 0;
const partSpans = parts.map((p) => {
  const span = { ...p, from: start + 1, to: start + p.chapters };
  start += p.chapters;
  return span;
});
---
<Reading
  title={`${book.title}: ${book.subtitle} — Kevin Holler`}
  description={description}
  here="book"
  indexed
  image={cover}
  imageAlt={coverAlt}
>
  <div class="bk">
    <!-- 1 · Hero ─────────────────────────────────────────── -->
    <section class="bk-band bk-hero">
      <figure class="bk-cover">
        <Image
          src={cover}
          alt={coverAlt}
          widths={[320, 640, 1060]}
          sizes="(max-width: 760px) 60vw, 380px"
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <div class="bk-hero-text">
        <p class="bk-kicker">A memoir · in progress</p>
        <h1>{book.title}</h1>
        <p class="bk-sub">{book.subtitle}</p>
        {pitch.map((p) => <p class="bk-pitch">{p}</p>)}

        <div class="bk-offer" id="chapters">
          <h2>Read {book.freebie} free</h2>
          <ul class="bk-checks">
            {
              freeChapters.length
                ? freeChapters.map((c) => (
                    <li>
                      <strong>{c.title}</strong>
                      {c.line && <span> — {c.line}</span>}
                    </li>
                  ))
                : <li>{cap(book.freebie)}, by email</li>
            }
            <li>One note on the day the book launches</li>
          </ul>
          <BookSignup id="top" />
        </div>
      </div>
    </section>

    <!-- 2 · The shape ────────────────────────────────────── -->
    <section class="bk-shape" aria-labelledby="bk-shape-title">
      <h2 class="bk-rule-title" id="bk-shape-title"><span>Sixteen chapters, three parts</span></h2>
      <p class="vh">
        The book runs from 2014 to 2016 in three parts:
        {partSpans.map((p) => `${p.name} (${p.years}, ${p.chapters} chapters). `)}
      </p>
      <div class="bk-bars" aria-hidden="true">
        {bars.map((b) => <i style={`--h:${b.height}%;--c:${b.color}`} />)}
      </div>
      <ol class="bk-parts" aria-hidden="true">
        {
          partSpans.map((p, i) => (
            <li style={`--span:${p.chapters}`}>
              <span class="bk-part-no">Part {['One', 'Two', 'Three'][i]}</span>
              <span class="bk-part-name">{p.name}</span>
              <span class="bk-part-years">{p.years}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- 3 · What you'll read ─────────────────────────────── -->
    <section class="bk-section" aria-labelledby="bk-beats-title">
      <h2 class="bk-title" id="bk-beats-title">What you’ll read</h2>
      <p class="bk-intro">Not a playbook. The other account, in the order it happened:</p>
      <ol class="bk-beats">
        {moments.map((m) => <li>{m}</li>)}
      </ol>
    </section>

    <!-- 4 · How it's written ─────────────────────────────── -->
    <section class="bk-band bk-why" aria-labelledby="bk-why-title">
      <h2 class="bk-title" id="bk-why-title">Why I’m writing it</h2>
      <div class="bk-prose">
        <p>
          When my first company failed, I wrote a blog post announcing we were
          shutting down. In Ireland at the time, failure was rarely spoken
          about openly. I published the post, shut my laptop, and went for a
          walk.
        </p>
        <p>
          Twenty-four hours later there were job offers, interview requests,
          and founders emailing to say the same thing had happened to them.
          Almost every startup memoir is written by someone who won. This one
          isn’t.
        </p>
      </div>

      <h3 class="bk-subtitle">How it’s written</h3>
      <ul class="bk-pillars">
        {
          promises.map((c) => (
            <li>
              <span class="bk-pillar-name">{c.name}</span>
              <span class="bk-pillar-gloss">{c.gloss}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 5 · Early readers (only once there are some) ──────── -->
    {
      praise.length > 0 && (
        <section class="bk-section" aria-labelledby="bk-praise-title">
          <h2 class="bk-title" id="bk-praise-title">From early readers</h2>
          <ul class="bk-praise">
            {praise.map((p) => (
              <li>
                <blockquote>“{p.quote}”</blockquote>
                <p class="bk-praise-name">{p.name}</p>
                {p.role && <p class="bk-praise-role">{p.role}</p>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- 6 · About the author ─────────────────────────────── -->
    <section class="bk-section bk-author" aria-labelledby="bk-author-title">
      <Image
        class="bk-author-photo"
        src={portrait}
        alt="Kevin Holler."
        widths={[240, 480]}
        sizes="240px"
        loading="lazy"
      />
      <div>
        <h2 class="bk-title" id="bk-author-title">About the author</h2>
        <p>
          Kevin Holler grew up in Ireland and graduated in Dublin in 2011,
          into a country exporting its young. Before the company in this book
          he was the first sales engineer in Europe for Engine Yard and then
          New Relic. Today he works in Field Engineering at CodeRabbit and
          lives in Würzburg, Germany.
        </p>
      </div>
    </section>

    <!-- 7 · Closing offer ────────────────────────────────── -->
    <section class="bk-band bk-close" aria-labelledby="bk-close-title">
      <Image
        class="bk-close-cover"
        src={cover}
        alt=""
        widths={[160, 320]}
        sizes="160px"
        loading="lazy"
      />
      <div class="bk-close-text">
        <h2 id="bk-close-title">Start with {book.freebie}</h2>
        <p>Free, by email — and one note when the book is out.</p>
        <BookSignup id="end" />
      </div>
    </section>
  </div>
</Reading>
