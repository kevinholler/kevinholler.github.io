---
import { Image } from 'astro:assets';
import Reading from '../../../layouts/Reading.astro';
import { talks } from '../../../data/talks';

// Never ask for a width the source can't supply. A still smaller than the
// 44rem figure renders sharp at its own size rather than upscaled and soft.
// The source's own width is always offered, so a high-DPR screen still gets
// every pixel the file actually has.
const widthsFor = (width: number) => {
  const candidates = [560, 704, 1408].filter((w) => w < width);
  return [...new Set([...candidates, width])];
};
---
<Reading
  title="Talks — Kevin Holler"
  description="Talks by Kevin Holler, with recordings where they exist."
  here="talks"
>
  <h1>Talks</h1>
  <p class="stamp">Recordings where they exist.</p>

  <ul class="work">
    {
      talks.map((talk) => (
        <li>
          <div class="row">
            <span class="name">{talk.title}</span>
            <span class="years">
              {talk.event}
              {talk.year && ` · ${talk.year}`}
            </span>
          </div>

          {talk.still && talk.video && (
            <figure class="figure">
              <a class="still" href={talk.video} rel="noreferrer">
                <Image
                  src={talk.still}
                  alt={`${talk.title} — title card from the recording`}
                  widths={widthsFor(talk.still.width)}
                  sizes={`(max-width: 44rem) 100vw, ${Math.min(talk.still.width, 704)}px`}
                />
                <span class="play" aria-hidden="true" />
              </a>
              <figcaption>Watch the recording — opens on YouTube.</figcaption>
            </figure>
          )}

          <p>{talk.description}</p>

          {talk.video && !talk.still && (
            <p class="links">
              <a href={talk.video} rel="noreferrer">Watch the recording</a>
            </p>
          )}
        </li>
      ))
    }
  </ul>
</Reading>
