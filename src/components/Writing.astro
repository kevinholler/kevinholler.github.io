---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---
<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <div class="eyebrow">/ 04 Writing</div>
        <h2 class="serif" style="margin-top: 12px;">Notes from the field.</h2>
      </div>
      <p>I write in fits and starts — usually after something breaks, or after I learn something the hard way.</p>
    </div>
    <div class="writing-grid">
      {posts.map((p) => (
        <a href={`/blog/${p.slug}/`} class="writing-cell">
          <span class="date">
            {p.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'short' })} · {p.data.tags?.[0] ?? 'Writing'}
          </span>
          <h3>{p.data.title}</h3>
          <p>{p.data.description}</p>
          <span class="read-more">Read essay →</span>
        </a>
      ))}
    </div>
  </div>
</section>
