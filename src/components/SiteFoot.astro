---
// Everything that leaves the site. Page navigation lives in the header now,
// so this row is only the ways to reach me elsewhere.
const elsewhere = [
  { label: 'Email', href: 'mailto:hello@kevinholler.com' },
  { label: 'GitHub', href: 'https://github.com/kevinholler' },
];
---
<footer class="site-foot">
  <div class="bar foot-inner">
    <nav aria-label="Elsewhere">
      {elsewhere.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</footer>
