---
// The masthead. The name is the link home, so there's no separate "Index"
// item, and the page you're on is shown rather than removed — the row stays
// the same length everywhere.
//
// The sections themselves live in src/data/nav.ts, grouped. A wider gap used
// to be the only thing marking a group boundary — it read as uneven spacing
// rather than structure, and left "About" looking stranded off on its own.
// A middot marks it instead: the same device the rest of the site already
// uses to join short related fragments ("Trackplan · ChangeX · Pampers").
import { navGroups, type NavId } from '../data/nav';

interface Props {
  here?: NavId;
}

const { here } = Astro.props;
---
<header class="site-head">
  <div class="bar">
    <div class="head-inner">
      <div class="head-top">
        <a class="wordmark" href="/new/" aria-current={here === 'index' ? 'page' : undefined}>
          Kevin Holler
        </a>
        <!-- Both marks ship; CSS shows the one that matches the current
             theme, so the icon is right on first paint with no JS. Each is
             the destination, not the current state: a moon means "go dark".
             Drawn as hairlines, like the play mark on the talks page — the
             only other piece of interface chrome on the site. -->
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme">
          <svg class="mark moon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M16.5 12.6A7 7 0 0 1 7.4 3.5a7 7 0 1 0 9.1 9.1Z" />
          </svg>
          <svg class="mark sun" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <circle cx="10" cy="10" r="3.9" />
            <path d="M10 1.6v2.1M10 16.3v2.1M18.4 10h-2.1M3.7 10H1.6M15.9 4.1l-1.5 1.5M5.6 14.4l-1.5 1.5M15.9 15.9l-1.5-1.5M5.6 5.6 4.1 4.1" />
          </svg>
        </button>
        <script is:inline>
          // Runs while the header is still parsing, so the label is correct
          // on first paint rather than corrected a moment later.
          (function () {
            var root = document.documentElement;
            var btn = document.getElementById('theme-toggle');
            // Which mark is visible is CSS's job now. All this has to keep
            // in step is the label the button announces.
            function sync() {
              var dark = root.dataset.theme === 'dark';
              btn.setAttribute(
                'aria-label',
                dark ? 'Switch to light theme' : 'Switch to dark theme',
              );
            }
            sync();
            btn.addEventListener('click', function () {
              var dark = root.dataset.theme === 'dark';
              if (dark) delete root.dataset.theme;
              else root.dataset.theme = 'dark';
              try {
                localStorage.setItem('theme', dark ? 'light' : 'dark');
              } catch (e) {}
              sync();
            });
          })();
        </script>
      </div>
      <nav class="head-nav" aria-label="Primary">
        {
          navGroups.map((group, i) => (
            <>
              {i > 0 && <span class="nav-sep" aria-hidden="true">·</span>}
              {group.map((l) => (
                <a href={l.href} aria-current={here === l.id ? 'page' : undefined}>
                  {l.label}
                </a>
              ))}
            </>
          ))
        }
      </nav>
    </div>
  </div>
</header>
