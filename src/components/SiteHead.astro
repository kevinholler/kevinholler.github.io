---
// The masthead. The name is the link home, so there's no separate "Index"
// item, and the page you're on is shown rather than removed — the row stays
// the same length everywhere.
//
// The sections themselves live in src/data/nav.ts, grouped. A wider gap
// between groups is the only thing marking them.
import { navGroups, type NavId } from '../data/nav';

interface Props {
  here?: NavId;
}

const { here } = Astro.props;
---
<header class="site-head">
  <div class="bar">
    <div class="head-inner">
      <div class="head-top">
        <a class="wordmark" href="/new/" aria-current={here === 'index' ? 'page' : undefined}>
          Kevin Holler
        </a>
        <button class="theme-toggle" id="theme-toggle" type="button">Dark</button>
        <script is:inline>
          // Runs while the header is still parsing, so the label is correct
          // on first paint rather than corrected a moment later.
          (function () {
            var root = document.documentElement;
            var btn = document.getElementById('theme-toggle');
            function sync() {
              var dark = root.dataset.theme === 'dark';
              btn.textContent = dark ? 'Light' : 'Dark';
              btn.setAttribute(
                'aria-label',
                dark ? 'Switch to light theme' : 'Switch to dark theme',
              );
            }
            sync();
            btn.addEventListener('click', function () {
              var dark = root.dataset.theme === 'dark';
              if (dark) delete root.dataset.theme;
              else root.dataset.theme = 'dark';
              try {
                localStorage.setItem('theme', dark ? 'light' : 'dark');
              } catch (e) {}
              sync();
            });
          })();
        </script>
      </div>
      <nav class="head-nav" aria-label="Primary">
        {
          navGroups.map((group) => (
            <span class="nav-group">
              {group.map((l) => (
                <a href={l.href} aria-current={here === l.id ? 'page' : undefined}>
                  {l.label}
                </a>
              ))}
            </span>
          ))
        }
      </nav>
    </div>
  </div>
</header>
